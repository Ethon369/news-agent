# ============================================================
# AI Daily Agent —— 环境变量模板
# 复制为 .env 后填写真实值；.env 已被 .gitignore 忽略，切勿提交。
# ============================================================

# ---------- 应用 ----------
APP_ENV=dev
APP_HOST=127.0.0.1
APP_PORT=8000
APP_TIMEZONE=Asia/Shanghai
# 数据与 Agent 工作区（相对仓库根目录）
DATABASE_URL=sqlite:///./data/ai_daily.db
WORKSPACE_DIR=./workspace

# ---------- LLM（OpenAI 兼容协议） ----------
# 默认 DeepSeek：https://api.deepseek.com
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3
LLM_TIMEOUT_SECONDS=90
# mock = 开箱即用（不调用真实模型，用确定性脚本模型 + 内置演示新闻跑通全流程）
# real = 调用真实模型（需要在下方填写 LLM_API_KEY）
LLM_MODE=mock
# 单次模型回复的最大 token 数（publish_briefing 需要足够空间输出完整 JSON）
LLM_MAX_TOKENS=4096
# 单次简报运行的最大 Agent 步数（防止死循环）
AGENT_MAX_STEPS=24
# 单次运行的累计 prompt token 预算（所有请求之和），超过后强制进入收尾
AGENT_TOKEN_BUDGET=500000

# ---------- 新闻源 ----------
# Bing News RSS 搜索（免 Key）
NEWS_BING_ENABLED=true
NEWS_BING_ENDPOINT=https://www.bing.com/news/search
NEWS_LANGUAGE=zh-CN
# 固定 RSS 源（逗号分隔，可自行增删）
NEWS_RSS_FEEDS=https://hnrss.org/frontpage,https://rss.arxiv.org/rss/cs.AI,https://techcrunch.com/category/artificial-intelligence/feed/,https://www.jiqizhixin.com/rss
# 单次运行最多抓取的文章数
NEWS_MAX_ARTICLES=30

# ---------- 推送渠道 ----------
# web=站内（始终开启）；feishu=飞书群机器人；email=SMTP 邮件
PUSH_CHANNELS=web
FEISHU_WEBHOOK_URL=
FEISHU_SECRET=
FEISHU_VERIFY_SSL=true
# 邮件推送（QQ 邮箱示例：smtp.qq.com / 465 / 开启 SSL；SMTP_PASSWORD 填「授权码」而不是登录密码）
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=true

# ---------- 定时任务 ----------
SCHEDULER_ENABLED=true
# 每日简报生成时间（HH:MM，应用时区）
DAILY_RUN_TIME=08:00
